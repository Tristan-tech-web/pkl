# Salin ke .env.local (jangan di-commit). Nilai asli hanya di Vercel/Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server saja (Vercel, tipe sensitive). Daftar dipisah koma.
GEMINI_API_KEYS=
# Kunci master untuk mengenkripsi kunci API milik sekolah (BYOK), 32 byte base64.
AI_KEY_ENCRYPTION_SECRET=
